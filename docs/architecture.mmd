%% FormBuddy Architecture v2 — Good Neighbor track (video-ready)
%% Render: https://mermaid.live or `mmdc -i architecture.mmd -o architecture.png`
%% Design: 3 layers (See -> Decide -> Act), approval gate as diamond, two lanes.

flowchart TB
    subgraph L1["LAYER 1 — SEE (read the real form)"]
        direction LR
        U1["User gives URL\n+ profile + doc photo"]
        U2["User opens form tab\n+ extension profile"]
        WEB["Web Chat UI\nfrontend/"]
        EXT["Chrome Extension\nsidepanel + background.js"]
        INS1["inspect_form\nHaiku + AgentCore Browser"]
        INS2["inspect_provided_html\nHaiku, no browser"]
        DOC["document_parser\nBedrock vision"]

        U1 --> WEB
        U2 --> EXT
        WEB --> INS1
        EXT --> INS2
        WEB --> DOC
    end

    subgraph L2["LAYER 2 — DECIDE (human approval gate)"]
        direction LR
        ORCH["Orchestrator\nStrands Agent (Haiku default)\nmatch -> ask-if-missing -> log -> propose"]
        PROP["propose_form_fill\nrefuses if required empty"]
        GATE{"Human approves?\nApprove / Reject"}
        ORCH --> PROP --> GATE
    end

    subgraph L3["LAYER 3 — ACT (only after Approve)"]
        direction LR
        CLOUD["Cloud lane\nAgentCore Browser\nfill + SUBMIT"]
        EXT2["Extension lane\nlocal DOM fill\nNO submit (user clicks)"]
        STORE[("Session + Audit\nlocal JSON / DynamoDB\nMemory swap-in")]
        CLOUD --> STORE
        EXT2 --> STORE
    end

    INS1 --> ORCH
    INS2 --> ORCH
    DOC --> ORCH
    GATE -->|Approved, cloud| CLOUD
    GATE -->|Approved, extension| EXT2
    GATE -->|Rejected| STORE

    style ORCH fill:#0f766e,color:#fff
    style PROP fill:#d97706,color:#fff
    style GATE fill:#be123c,color:#fff
    style CLOUD fill:#1d4ed8,color:#fff
    style EXT2 fill:#1d4ed8,color:#fff
